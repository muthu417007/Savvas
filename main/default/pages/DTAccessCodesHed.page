   <script type="text/javascript">     
  function setTabTitle() {
           sforce.console.setTabTitle('HigherEd Customer Assistance');
       }      
       var previousOnload = window.onload;       
       window.onload = function() {
            if (previousOnload) {
                previousOnload();
            }               
            setTimeout('setTabTitle()', '500');
       }
   </script>      
