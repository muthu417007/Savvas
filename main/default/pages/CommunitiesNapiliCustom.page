<apex:page showHeader="false" sidebar="false" id="CommunitiesTemplate" applyBodyTag="false" applyHtmlTag="false" docType="html-5.0" standardStylesheets="false">
<html>
    <head lang="en">
        <meta charset="utf-8" />
      <apex:insert name="head" />
        <title>Savvas Community</title>
       
        <meta name="description" content="Savvas Customer Care Community" />
        <meta name="keywords" content="Support, technical help, service, knowledge" />
        <meta name="author" content="Savvas Learning Company" />
        <meta http-equiv="X-UA-Compatible" content="IE=edge" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
        <meta name="mobile-web-app-capable" content="yes" />
        <meta name="apple-mobile-web-app-capable" content="yes" />

        <link href="{!URLFOR($Resource.CocoResponsive2016, 'css/bootstrap.css')}" rel="stylesheet" />
        <link href="{!URLFOR($Resource.CocoResponsive2016, 'css/custom.css')}" rel="stylesheet" />
        <link href="{!URLFOR($Resource.CocoResponsive2016, 'css/customVF.css')}" rel="stylesheet" />

        <!-- HTML5 for IE6-8 support of HTML elements -->
        <!--[if lt IE 9]>
        <script src="{!URLFOR($Resource.CocoResponsive, 'js/html5.js')}"></script>
        <![endif]-->

    </head>

    <body>
        <div class="mainContainer">
            <!-- HEADER -->
            <div >
                <header class="navbar navbar-inverse">
                        <div class="header">
                            <a href="/"><div class="logo col-xs-12" style="background-image: url('{!URLFOR($Resource.HED_SavLogo) }');width:100%;">&nbsp;</div></a>
                        </div>
                            <div class="clear"></div>
                        <div class="navbar-strap"><span class="sitename">Savvas Customer Care Community</span></div>
                        <div class="navbar-header" style="background-color: #2150A3!important"><a href="/support/s" style="color:#FFFFFF;">Return to Site</a>
                        </div>
                </header>
            </div>
            

                    <!-- CONTENT -->
            <div class="container paddingBottom15">
       
                <apex:insert name="mainbody" />
            </div>
            <!-- //CONTENT -->

            <!-- FOOTER -->
            <div class="noPadding">   

                <copyright>
                    <div class="row">
                        <div class="col-xs-12 text-center" style="padding:2px;">
                            Copyright &copy;2020 Savvas Learning Company  &amp; its Affiliates. All Rights Reserved.
                        </div>
                    </div>
                </copyright>
                <div class=" footerLinks">
                    <div class="row">
                        <div class="col-xs-12 text-center">
                            <a href="/support/s/Terms_of_Use" target="">Terms Of Use</a>
                            <a href="/support/s/Privacy_Policy" target="">Privacy Policy</a>
                        </div>
                    </div>
                </div>
                
                <!-- //FOOTER -->

            </div><!--//.container -->

        </div><!--//.container -->

        <!-- Load javascript... -->
        <script type="text/javascript" src="{!URLFOR($Resource.CocoResponsive, 'js/jquery-1.11.1.min.js')}"> </script>
        <script type="text/javascript" src="{!URLFOR($Resource.CocoResponsive, 'js/bootstrap.min.js')}"> </script>
        <script type="text/javascript" src="{!URLFOR($Resource.CocoResponsive, 'js/custom.js')}"> </script>
        <script type="text/javascript">
         <!--  var menu = {!menuJSon};-->
          <!-- if (menu) {-->
         <!--      createMenu(menu);-->
       <!--  //   }-->
            $(".preFooter div").click(function(){
              window.location = $(this).attr("data-href");
              return false;
             });
             
             
            // Google Analytics Tracking
            var _gaq = _gaq || [];
            _gaq.push(['_setAccount', '{!$Label.CommunityAnalyticsTrackingCode}']);
            _gaq.push(['_trackPageview',$(location).attr('pathname')]);
            
            
            (function () { 
            
                 var ga = document.createElement('script'); ga.type = 'text/javascript'; ga.async = true;
                 ga.src=('https:' == document.location.protocol ? 'https://ssl' : 'http://www') + '.google-analytics.com/ga.js';
                 var s = document.getElementsByTagName('script')[0]; s.parentNode.insertBefore(ga, s);
                console.log('GA Variables');
                console.log(ga.src);
                console.log(_gaq);
             })();    
                 
        </script>
       
    </body>
</html>
</apex:page>