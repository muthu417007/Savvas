    @future(callout=true) 
    public static void queryCapability(){
        //Perform Login callout to buzz to get session token and domain Id
        BuzzLoginCallout callout=new BuzzloginCallout();
        List<string> loginInfo=callout.basicAuthCallout();
        if(loginInfo.size()>0){
            List<Enrollment> completedEnrollment=new List<Enrollment>();
            // Format date for last 24 hours
            datetime dt=dateTime.now().addDays(-1);
            String previousDate=dt.format('yyyy-MM-dd\'T\'HH:mm:ss');
            Http http = new Http();
            HttpRequest request = new HttpRequest();
            // Endpoint queries enrollment modified in last day and enrollment doesn't have an external ID
            // and where the user and course has external ID's.
            // The External ID for the user is the Saleforce Resource ID
            // The External ID for the course is the Capability Type ID
            // The External ID for the enrollment is the Resource Capability ID
            request.setEndpoint('https://api.agilixbuzz.com/cmd?cmd=listenrollments&domainid='+loginInfo[1]+'&select=course,user&query=/reference=\'\'and/modifieddate>'+previousDate+'&userquery=/reference<>\'\'&coursequery=/reference<>\'\'');
            request.setMethod('GET');
            request.setHeader('Cookie','AZT='+loginInfo[0]);
            request.setHeader('Accept','application/json');
            //If a test class is running, create a mock test data and use data for http callout
        	//the if statement handles multiple test scenario's based on http response
            if (Test.isRunningTest() && String.isBlank(testVariable)) {
                BuzzGetEnrollmentCalloutMock fakeResponse=new BuzzGetEnrollmentCalloutMock('Success');
                Test.setMock(HttpCalloutMock.class, fakeResponse); 
            }else if(Test.isRunningTest() && testVariable.equalsIgnoreCase('badRequest')) {
                BuzzGetEnrollmentCalloutMock fakeResponse=new BuzzGetEnrollmentCalloutMock('badRequest');
                Test.setMock(HttpCalloutMock.class, fakeResponse); 
            }
            HttpResponse response=http.send(request);               
            // If the request is successful, parse the JSON response.
            if (response.getStatusCode() == 200) {
                // Deserialize the JSON string into objects.      
                EnrollmentJson obj=parse(response.getbody());
                //Check if the response contains enrollment data
                //If the response is a bad request, send email to integration admin public group
                //system.debug(obj.response.code);
                if(obj.response.code=='OK' && obj.response.enrollments.enrollmentList!=null){
                    //Loop through courses and search for the status equals Completed         
                    for(enrollment e:obj.response.enrollments.enrollmentList){
                        if(e.status==7){
                            completedEnrollment.add(e);
                        }
                    }
                    // Only perform an insert if there is course enrollment that is completed
                    if(completedEnrollment.size()>0){
                        insertCapability(completedEnrollment);
                    }
                }else if(obj.response.code=='BadRequest'){
                    // Call Utility class that sends emails message
                    BuzzIntegrationUtility.sendEmailError('BadRequest');
                }
            }            
        }
    }
    
    // Method that insert the enrollment as Resource Capability
    // The method calls the Kimble Interface CapabilitiesRatingImport
    public static void insertCapability(List<enrollment> enrollmentList){
        
        // Create a JSONGenerator object.
        // Format the JSON to the Kimble format for import
        // Pass true to the constructor for pretty print formatting.
        JSONGenerator gen = JSON.createGenerator(true);
        gen.writeStartArray();
        for(enrollment e:enrollmentList){
            // Check if the course are mapped to multiple capability type
            if(e.course.reference.contains(',')){
                string capabilityType=e.course.reference;
                list<String> capabilityTypesList=capabilityType.split(',');
                for(Integer i=0;i<capabilityTypesList.size();i++){
                    gen.writeStartObject();
            		gen.writeStringField('Resource',e.userRec.reference);
            		gen.writeStringField('CapabilityType',capabilityTypesList[i]);
            		gen.writeBooleanField('Rating',true);
                    if(i>0){
            			gen.writeStringField('BuzzEnrollmentId',e.Id+'-Duplicate-'+i);
                    }else{
                        gen.writeStringField('BuzzEnrollmentId',e.Id);
                    }
            		gen.writeEndObject();
                }
            }else{
            	gen.writeStartObject();
            	gen.writeStringField('Resource',e.userRec.reference);
            	gen.writeStringField('CapabilityType',e.course.reference);
            	gen.writeBooleanField('Rating',true);
            	gen.writeStringField('BuzzEnrollmentId',e.Id);
            	gen.writeEndObject();
            }
        }
        gen.writeEndArray();
        String JSONString= gen.getAsString();
        
        if(JSONString.contains('Resource')){
            // Calls the Kimble Interface to insert the Resource Capability records into Salesforce
            RestRequest request = new RestRequest();
            string endpointPath = '/services/apexrest/KimbleOne/v1.0/Import/BuzzCapabilitiesImport';
            request.requestURI = endpointPath.trim();
            request.httpMethod = 'POST';
            request.requestBody = Blob.valueOf(JSONString);
            RestContext.request = request;
            RestContext.response = new RestResponse();           
            KimbleOne.InboundInterfaceRunRestService.CreateImport();
            //If successfully created the request to import the resource capability
            //the response status code is null
            if(RestContext.response.statusCode!=null){
                system.debug('Kimble Interface Status Code: '+RestContext.response.statusCode);
                // Call Utility class that sends emails message
                BuzzIntegrationUtility.sendEmailError('Kimble Interface Status Code: '+RestContext.response.statusCode);             
            }          
        }   
    }
