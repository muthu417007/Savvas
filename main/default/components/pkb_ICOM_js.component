function copyCommentsICOM() {
    copyComments();
    var o = $$('[id$=' + FEEDBACK_COMMENTS_ID + ']');
    if (o.length && (o[0].value === null || o[0].value === undefined || $$.trim(o[0].value) === '')) {
        var b = $$('#' + FEEDBACK_TEXT_ID);
        if (b.parent().find('span.error').length == 0) {
            $$('<span class="error" style="color:red;">Please enter some feedback</span>').insertBefore(b)
        }
        return false;
    }
    return true;
}
//wmigas 9/02/14 end
</script>
</apex:component>