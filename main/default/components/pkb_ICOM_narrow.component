<apex:component allowDML="true" layout="none">
<apex:attribute name="pkbCon" type="pkb_Controller" required="true" description="handle to the pkb controller" />
<apex:attribute name="pkbIcomCon" type="pkb_ICOM_Controller" required="true" description="handle to the pkb ICOM controller" />

<apex:variable var="columnCount" value="{!1}" />
<apex:variable var="columnCount" value="{!columnCount+1}" rendered="{!pkbCon.displayCategory1}" />
<apex:variable var="columnCount" value="{!columnCount+1}" rendered="{!pkbCon.displayCategory2}" />
<apex:variable var="columnCount" value="{!columnCount+1}" rendered="{!pkbCon.displayCategory3}" />


   <apex:outputPanel layout="block" styleClass="narrowSearch" rendered="{!pkbCon.displayNarrow}" id="narrowSearch">
     <h2 class="section">{!$Label.PKB2_Narrow_Search}</h2>

       <c:pkb_ICOM_articletypeselect pkbCon="{!pkbCon}" pkbIcomCon="{!pkbIcomCon}"/>
       
     <apex:outputPanel layout="block" styleClass="searchDrill col-xs-12 col-sm-{!IF(columnCount>=4,12/columnCount,4)} col-md-3" rendered="{!pkbCon.displayCategory1}">
       <c:pkb_ICOM_categoryselect catNum="1" 
         catGroup="{!pkbCon.categoryGroup1}" 
         catGroupLabel="{!pkbCon.categoryLabel1}" 
         rootCat="{!pkbCon.rootCategory1}" />
     </apex:outputPanel>

     <apex:outputPanel layout="block" styleClass="searchDrill col-xs-12 col-sm-{!IF(columnCount>=4,12/columnCount,4)} col-md-3" rendered="{!pkbCon.displayCategory2}">
       <c:pkb_ICOM_categoryselect catNum="2" 
         catGroup="{!pkbCon.categoryGroup2}" 
         catGroupLabel="{!pkbCon.categoryLabel2}" 
         rootCat="{!pkbCon.rootCategory2}" />
     </apex:outputPanel>

     <apex:outputPanel layout="block" styleClass="searchDrill col-xs-12 col-sm-{!IF(columnCount>=4,12/columnCount,4)} col-md-3" rendered="{!pkbCon.displayCategory3}">
       <c:pkb_ICOM_categoryselect catNum="3" 
         catGroup="{!pkbCon.categoryGroup3}" 
         catGroupLabel="{!pkbCon.categoryLabel3}" 
         rootCat="{!pkbCon.rootCategory3}" />
     </apex:outputPanel>
   </apex:outputPanel>

<script type="text/javascript">setCurrCategories2();</script>
</apex:component>