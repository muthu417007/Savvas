<aura:component implements="forceCommunity:themeLayout" access="global" description="Savvas Login Page">
    <aura:attribute name="backgroundImageURL" type="String" default=""/>
    <aura:attribute name="copyRight" type="String" default=""/>
    <aura:handler name="init" value="{!this}" action="{!c.doInit}"/> 
    <ltng:require styles="{! $Resource.BootStrap + '/bootstrap-5.0.2-dist/css/bootstrap.min.css'}" scripts="{! $Resource.BootStrap + '/bootstrap-5.0.2-dist/js/bootstrap.min.js'}" afterScriptsLoaded="{!c.scriptsLoaded}"/>
    <div class="logoContainerBg" style="{!'background-image: url('+v.backgroundImageURL+');'}">
        <!--div class="logoContainerBg" style="{!'background-image: url('+v.backgroundImageURL+'); background-repeat: no-repeat; background-size:cover;background-position:inherit; width:100vw;height:100vh;display:flex; justify-content: center;align-items: center; margin:0'}"-->
        <div class="loginContainer col-xl-6 col-lg-6 col-md-8 col-sm-10">
            <div class="loginPage">{!v.body}</div>
            <div class="copyright">
                <p>{!$Label.c.Savvas_Copyright}</p>
            </div>        
        </div>    
    </div>
</aura:component>