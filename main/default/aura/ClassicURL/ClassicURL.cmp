<aura:component implements="flexipage:availableForRecordHome,force:hasRecordId,force:hasSObjectName" access="global">
    <aura:attribute name="recordId" type="String"/>
    <aura:attribute name="myRecordID" type="String" default="ID hasn't been set yet!"/>
    <aura:attribute name="sObjectName" type="String" />
    <aura:handler name="init" value="{!this}" action="{!c.doInit}"/>
    <lightning:card title="Classic URL" iconName="standard:link">
		<article class="slds-card">
     		<div class="slds-card__body slds-card__body_inner">https://savvas.my.salesforce.com/{!v.myRecordID}</div>
    	</article>
    </lightning:card>
 </aura:component>