<aura:component implements="force:appHostable,flexipage:availableForAllPageTypes,flexipage:availableForRecordHome,force:hasRecordId,forceCommunity:availableForAllPageTypes,force:lightningQuickAction"
                access="global"
                controller="Legal_Resource_List_Controller">
    
    <!--aura attributes-->  
    <aura:attribute name="catName" type="string"/>
    <aura:attribute name="selectedDocumentId" type="string"/>
    <aura:attribute name="contentDocs" type="List"/>
    <aura:attribute name="hasModalOpen" type="boolean" default="false"/>
    <aura:attribute name="hasMainModalOpen" type="boolean" default="false"/>    
    <div class="slds-grid slds-gutters">
        <div class="slds-col">
            <span><img src="{!$Resource.Company_Information_Lgl}" name = "Company Information" title = "Company Information" onclick="{!c.handleClick}" style="height: 125px;width: 200px;"></img></span>
        </div>
        <div class="slds-col">
            <span><img src="{!$Resource.Compliance_Lgl}" name = "Compliance" title = "Compliance" onclick="{!c.handleClick}" style="height: 125px;width: 200px;"></img></span>
        </div>
        <div class="slds-col">
            <span><img src="{!$Resource.Insurance_Lgl}" name = "Insurance" title = "Insurance" onclick="{!c.handleClick}" style="height: 125px;width: 200px;"></img></span>
        </div>
        <div class="slds-col">
            <span><img src="{!$Resource.Intellectual_Property_Lgl}" name = "Intellectual Property" title = "Intellectual Property" onclick="{!c.handleClick}" style="height: 125px;width: 200px;"></img></span>
        </div>
        <div class="slds-col">
            <span><img src="{!$Resource.Labor_and_Employment_Lgl}" name = "Labor and Employment" title = "Labor and Employment" onclick="{!c.handleClick}" style="height: 125px;width: 200px;"></img></span>
        </div>
        <div class="slds-col">
            <span><img src="{!$Resource.Sales_Enablement_Lgl}" name = "Sales Enablement" title = "Sales Enablement" onclick="{!c.handleClick}" style="height: 125px;width: 200px;"></img></span>
        </div></div>
    <aura:if isTrue="{!v.hasMainModalOpen}">
        <section  role="dialog" tabindex="-1" aria-labelledby="modal-heading-01" aria-modal="true" aria-describedby="modal-content-id-1" class="slds-modal slds-fade-in-open">
            
            <div class="slds-modal__container">
                <header class="slds-modal__header">
                        <lightning:buttonIcon iconName="utility:close"
                                              onclick="{! c.closeMainModel }"
                                              alternativeText="close"
                                              variant="bare-inverse"
                                              class="slds-modal__close"/>
                        <h2 id="modal-heading-01" class="slds-text-heading_medium slds-hyphenate">{!v.catName}</h2>
                    </header>
                <div class="slds-modal__content slds-p-around_medium slds-text-align_center">
                    
                    <!-- Custom DataTable to Display List Of Available ContentDocuments Start-->  
                    <table class="slds-table slds-table_cell-buffer slds-table_bordered slds-table_col-bordered">
                        <thead>
                            <tr class="slds-line-height_reset">
                                <th class="slds-text-title_caps" scope="col">
                                    <div class="slds-truncate" title="Title">Title</div>
                                </th>
                                <th class="slds-text-title_caps" scope="col">
                                    <div class="slds-truncate" title="Description">Description</div>
                                </th>
                 
                            </tr>
                        </thead>
                        <tbody>
                            <aura:iteration items="{!v.contentDocs}" var="doc">
                                <tr class="slds-hint-parent" >
                                    <th scope="row">
                                        <div class="slds-truncate" style="white-space: normal;" title="{!doc.Title}">
                                            <!--store contentDocument Id in data-Id attribute-->
                                            <a onclick="{!c.getSelected}" data-Id="{!doc.Id}">{!doc.Title}</a>
                                        </div>
                                    </th>
                                    <th scope="row">
                                        <div class="slds-truncate" style="white-space: normal;" title="{!doc.Description}">{!doc.Description}</div>
                                    </th>

                                </tr> 
                            </aura:iteration>
                        </tbody>
                    </table></div>
                </div></section><div class="slds-backdrop slds-backdrop_open"></div>
        
        <!-- Custom DataTable to Display List Of Available ContentDocuments End-->  
        <!--###### FILE PREVIEW MODAL BOX START ######--> 
        <aura:if isTrue="{!v.hasModalOpen}">
            <section role="dialog" tabindex="-1" aria-labelledby="modal-heading-01" aria-modal="true" aria-describedby="modal-content-id-1" class="slds-modal slds-fade-in-open">
                
                <div class="slds-modal__container">
                    
                    <div class="slds-modal__content slds-p-around_medium slds-text-align_center">
                        <div style="width: 50%; margin: 0 auto; text-align: left">
                            <!--<lightning:fileCard> to preview file using content document Id -->
                            <lightning:fileCard fileId="{!v.selectedDocumentId}"/>
                        </div>
                    </div>
                    <footer class="slds-modal__footer">
                        <lightning:button variant="destructive"
                                          label="Close"
                                          title="Close"
                                          onclick="{! c.closeModel }"/>
                    </footer>
                    
                </div>
            </section> <div class="slds-backdrop slds-backdrop_open">
             </div>
        </aura:if>
           
        <!--###### FILE PREVIEW MODAL BOX END ######-->
        
    </aura:if>
</aura:component>